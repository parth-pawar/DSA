Problem statement:
Sam is curious about symmetric patterns, so he decided to create one.
For every value of ‘N’, return the symmetry as shown in the example.
Example:

Input: ‘N’ = 3

Output: 
*         *
* *     * *
* * * * * *
* *     * *
*         *




Solution:

public class Solution {
    public static void symmetry(int n) {
        
        // upper loop
        for (int i=n; i>=1; i--){

            for (int j=1; j<=n-i+1; j++){
                System.out.print("* ");
            }

            for (int s=1; s<=2*i-2; s++){
                System.out.print(" ");
            }

            for (int j=1; j<=n-i+1; j++){
                System.out.print("* ");
            }
            System.out.println();
        }

        // lower loop
        for (int i=1; i<=n-1; i++){

            for (int j=1; j<=n-i; j++){
                System.out.print("* ");
            }

            for (int s=1; s<=2*i; s++){
                System.out.print(" ");
            }

            for (int j=1; j<=n-i; j++){
                System.out.print("* ");
            }
            System.out.println();
        }
    }
}
}
